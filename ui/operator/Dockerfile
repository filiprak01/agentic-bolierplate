FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_AGENTIC_PROJECT_NAME="AP MVP Test"
ARG VITE_AGENTIC_JIRA_PROJECT_KEY="AP"
ARG VITE_AGENTIC_API_BASE_URL="http://localhost:8000"

ENV VITE_AGENTIC_PROJECT_NAME=${VITE_AGENTIC_PROJECT_NAME}
ENV VITE_AGENTIC_JIRA_PROJECT_KEY=${VITE_AGENTIC_JIRA_PROJECT_KEY}
ENV VITE_AGENTIC_API_BASE_URL=${VITE_AGENTIC_API_BASE_URL}

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
