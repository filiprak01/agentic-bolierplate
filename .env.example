GITHUB_TOKEN=
GH_TOKEN=
GITHUB_REPOSITORY=example-org/agentic-boilerplate
GITHUB_DEFAULT_BRANCH=main
GITHUB_AUTH_MODE=https
GIT_REMOTE_MODE=https
GITHUB_SSH_KEY_PATH=
GITHUB_SSH_PRIVATE_KEY=
GITHUB_SSH_PRIVATE_KEY_B64=
GITHUB_SSH_KNOWN_HOSTS_PATH=
GITHUB_SSH_STRICT_HOST_KEY_CHECKING=true

# Repository lanes used for multi-repo Jira/GitHub traceability.
# Keep these as owner/name values. Leave optional lanes blank when not used.
TARGET_IMPLEMENTATION_REPOSITORY=
TARGET_IMPLEMENTATION_DEFAULT_BRANCH=main
TARGET_IMPLEMENTATION_JIRA_DEV_PANEL_EXPECTED=true
BOILERPLATE_PROCESS_REPOSITORY=example-org/agentic-boilerplate
BOILERPLATE_PROCESS_DEFAULT_BRANCH=main
BOILERPLATE_PROCESS_JIRA_DEV_PANEL_EXPECTED=true
DOCUMENTATION_REPOSITORY=
DOCUMENTATION_DEFAULT_BRANCH=main
DOCUMENTATION_JIRA_DEV_PANEL_EXPECTED=false
AUTOMATION_REPOSITORY=
AUTOMATION_DEFAULT_BRANCH=main
AUTOMATION_JIRA_DEV_PANEL_EXPECTED=false

JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AGENT
JIRA_BOARD_ID=1

CONFLUENCE_BASE_URL=https://example.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=AGENT
CONFLUENCE_SPACE_URL=https://example.atlassian.net/wiki/spaces/AGENT/overview?homepageId=458864
CONFLUENCE_PARENT_PAGE_ID=458864
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Documentation publication. Release 1.2 defaults to GitHub Pages. Use
# confluence or both only when the target project explicitly enables
# Confluence publication.
DOCUMENTATION_PROVIDER=github_pages
GITHUB_PAGES_DOCS_URL=
GITHUB_PAGES_BRANCH=gh-pages
GITHUB_PAGES_SOURCE_DIR=docs
GITHUB_PAGES_CUSTOM_DOMAIN=
GITHUB_PAGES_DEPLOYMENT_MODE=github_actions
GITHUB_PAGES_DEPLOY_TOKEN=

AGILETEST_CLIENT_ID=
AGILETEST_API_TOKEN=

# Optional Figma access for UI/UX design handoff. Manual links and exported
# artifacts remain supported when token-based access is not configured.
FIGMA_TOKEN=
FIGMA_FILE_KEY=
FIGMA_PROJECT_URL=
FIGMA_EXPORTS_PATH=docs/design

# OCI-compatible container image naming and optional publishing.
# Local Docker Compose works with the defaults and does not require registry credentials.
AGENTIC_IMAGE_REGISTRY_HOST=
AGENTIC_IMAGE_NAMESPACE=agentic-boilerplate
AGENTIC_IMAGE_TAG=local
AGENTIC_IMAGE_PUSH_ENABLED=false
AGENTIC_IMAGE_PUBLISH_DRY_RUN=true
AGENTIC_IMAGE_REGISTRY_USERNAME=
AGENTIC_IMAGE_REGISTRY_TOKEN=
AGENTIC_IMAGE_REGISTRY_CREDENTIAL_REF=

# Explicit image references used by docker-compose.yml. CI/release tooling may
# override these with registry-qualified references such as
# ghcr.io/<owner>/<namespace>/operator-api:1.2.0 or
# artifactory.example.com/docker-local/<namespace>/operator-api:1.2.0.
AGENTIC_OPERATOR_API_IMAGE=agentic-boilerplate/operator-api:local
AGENTIC_OPERATOR_UI_IMAGE=agentic-boilerplate/operator-ui:local
AGENTIC_WORKER_PLATFORM_IMAGE=agentic-boilerplate/worker-platform:local
AGENTIC_WORKER_PRODUCT_PLANNING_IMAGE=agentic-boilerplate/worker-product-planning:local
AGENTIC_WORKER_ARCHITECTURE_IMAGE=agentic-boilerplate/worker-architecture:local
AGENTIC_WORKER_DEVELOPER_IMAGE=agentic-boilerplate/worker-developer:local
AGENTIC_WORKER_REVIEW_IMAGE=agentic-boilerplate/worker-review:local
AGENTIC_WORKER_TESTER_IMAGE=agentic-boilerplate/worker-tester:local
AGENTIC_WORKER_RELEASE_MANAGER_IMAGE=agentic-boilerplate/worker-release-manager:local
AGENTIC_WORKER_SCHEDULER_IMAGE=agentic-boilerplate/worker-scheduler:local
AGENTIC_WORKER_FRONTEND_IMAGE=agentic-boilerplate/worker-frontend:local
AGENTIC_WORKER_UI_UX_IMAGE=agentic-boilerplate/worker-ui-ux:local
AGENTIC_WORKER_SECURITY_IMAGE=agentic-boilerplate/worker-security:local
AGENTIC_WORKER_DOCS_CONFLUENCE_IMAGE=agentic-boilerplate/worker-docs-confluence:local
AGENTIC_WORKER_DEVOPS_PLATFORM_IMAGE=agentic-boilerplate/worker-devops-platform:local
AGENTIC_WORKER_DATA_PERSISTENCE_IMAGE=agentic-boilerplate/worker-data-persistence:local

CODEX_DEFAULT_MODEL=gpt-5.5
CODEX_DEFAULT_REASONING=medium
CODEX_DEFAULT_SPEED=normal
CODEX_ALLOW_HIGH_REASONING=true
CODEX_ALLOW_XHIGH_REASONING=false
CODEX_PAUSE_ON_LIMIT=true
CODEX_SAVE_FAILED_REQUEST=true

CODEX_LIMIT_SENTINEL_ENABLED=false
CODEX_LIMIT_SENTINEL_MODE=host_app_server
CODEX_LIMIT_APP_SERVER_COMMAND=codex app-server
CODEX_LIMIT_APP_SERVER_TRANSPORT=stdio
# Non-secret identifier for the signed-in ChatGPT/Codex account context.
CODEX_LIMIT_ACCOUNT_SCOPE_ID=default
# Optional explicit metered bucket. Empty uses rateLimits.limitId from App Server.
CODEX_LIMIT_BUCKET_ID=
CODEX_LIMIT_GUARD_CUTOFF_PERCENT=90
CODEX_LIMIT_STALE_AFTER_SECONDS=300
CODEX_LIMIT_FUTURE_TOLERANCE_SECONDS=30
CODEX_LIMIT_REFRESH_BEFORE_STAGE=true
CODEX_LIMIT_RECORD_SOURCE=codex_app_server
CODEX_ACCESS_TOKEN=

WORKER_ROLES=product_planning,architecture,developer,review,tester,release_manager,scheduler,platform,frontend,ui_ux,security,docs_confluence,devops_platform,data_persistence
TARGET_PROJECT_PATH=

# Local operator API/UI ports. The UI bundle must use a browser-reachable API
# URL because fetch calls run in the Product Owner browser, not inside Nginx.
AGENTIC_API_PORT=8000
AGENTIC_OPERATOR_UI_PORT=5173
VITE_AGENTIC_PROJECT_NAME=Agentic Boilerplate
VITE_AGENTIC_JIRA_PROJECT_KEY=AGENT
VITE_AGENTIC_API_BASE_URL=http://localhost:8000
AGENTIC_WORKER_POLL_INTERVAL_SECONDS=30

DURABLE_PO_INBOX_PATH=data/po-inbox
DURABLE_CONTEXT_PACKS_PATH=data/context-packs
DURABLE_CODEX_JOBS_PATH=data/codex-jobs
DURABLE_CODEX_RESULTS_PATH=data/codex-results
DURABLE_CODEX_LIMITS_PATH=data/codex-limits
DURABLE_AGENT_STATE_PATH=data/agent-state
DURABLE_AGENT_LOGS_PATH=data/agent-logs
AGENTIC_WORKSPACES_ROOT=data/agent-workspaces
DURABLE_PO_DECISIONS_PATH=data/po-decisions
DURABLE_SPRINTS_PATH=data/sprints
DURABLE_CONFLUENCE_MIRROR_PATH=data/confluence-mirror

SPRINT_COMPLEXITY_TARGET_MIN=10
SPRINT_COMPLEXITY_TARGET_MAX=14
SPRINT_COMPLEXITY_HARD_WARNING=15
SPRINT_MAX_STORIES=5
SPRINT_MAX_C3_STORIES=4

POSTGRES_DB=agentic
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
